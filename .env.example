# ---- Database (Neon / Supabase / Railway Postgres) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/yiwu?sslmode=require"

# ---- Auth.js ----
# Generate: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"
AUTH_URL="http://localhost:3000"

# ---- Stripe (dashboard.stripe.com -> Developers -> API keys) ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."             # from `stripe listen` or the dashboard webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Price IDs created in Stripe (see README step 3)
STRIPE_PRICE_PREMIUM_MONTHLY="price_..."      # 49 EUR / month
STRIPE_PRICE_PRO_MONTHLY="price_..."           # 89 EUR / month (Pro)
STRIPE_PRICE_LIFETIME="price_..."             # 399 EUR one-time

# ---- Email (resend.com) ----
RESEND_API_KEY="re_..."
EMAIL_FROM="Yiwu Index <no-reply@your-domain.com>"

# ---- Public ----
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_GA_ID=""                          # G-XXXXXXX (optional)
NEXT_PUBLIC_META_PIXEL_ID=""                  # optional
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""                # optional
