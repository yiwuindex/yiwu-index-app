generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  free
  premium
  lifetime
  vip
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          Role      @default(free)
  // when a recurring subscription is active, premium until this date; null for lifetime/vip (permanent) or free
  premiumUntil  DateTime?
  stripeCustomerId String? @unique
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  createdAt     DateTime  @default(now())
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  status               String   // active, canceled, past_due, incomplete, lifetime
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique          // YW-####
  name      String
  category  String
  products  String   @default("")
  tags      String[] @default([])
  district  String   @default("")
  verified  Boolean  @default(false)
  agent     Boolean  @default(false)
  // ---- PREMIUM-GATED fields: never sent to non-premium clients ----
  wechat    String[] @default([])
  email     String   @default("")
  tel       String   @default("")
  location  String   @default("")
  @@index([category])
}

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  businessType String
  avatarUrl    String?
  review       String
  rating       Int      @default(5)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ---- Auth.js adapter models ----
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String?
  access_token String?
  expires_at Int?
  token_type String?
  scope String?
  id_token String?
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
